# --- Básico ---
PORT=3000
PUBLIC_URL=https://asiste.pe
NODE_ENV=production
# Usuario dueño (usted). Se crea solo la primera vez que arranca.
OWNER_EMAIL=usted@correo.com
OWNER_PASSWORD=cambie-esta-clave-larga
OWNER_NAME=Godos Salvador
# Llave de cifrado de 32 bytes en hex (genere con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
DATA_KEY=
# Carpeta de datos (base de datos SQLite). En Render/Railway use un disco persistente.
DATA_DIR=./data
# Crear una clínica de ejemplo al arrancar por primera vez (para mostrar)
DEMO_SEED=false

# --- WhatsApp Business Platform (Meta) ---
# Token que usted inventa para verificar el webhook en Meta
WA_VERIFY_TOKEN=
# "Clave secreta de la app" en Meta for Developers > Configuración básica
WA_APP_SECRET=
WA_API_VERSION=v23.0

# --- IA opcional para preguntas fuera de lo común (apagada si está vacío) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
